# Required
SESSION_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32
APP_URL=http://localhost:3000

# Optional: path of the SQLite file (use a persistent volume in production)
DATABASE_PATH=./data/app.db

# Seeded admin account (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Stripe (test mode). Leave blank to run in demo mode with simulated payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Store ingestion (see README "Live data")
CRON_SECRET=                      # openssl rand -hex 32 — required to call /api/cron/ingest
INGEST_USER_AGENT=                # optional, e.g. "MyBot/1.0 (+https://yoursite.com/bot)"
MAX_STORES=300                    # global cap on tracked stores
MAX_STORES_PER_USER=25

# Ads job (optional) — Meta Ad Library API token. Without it the ads job is skipped.
META_ADS_ACCESS_TOKEN=
META_ADS_COUNTRIES=GB,DE,FR,IT,ES,NL,IE,SE,PL,BE   # the API only returns EU/UK-delivered ads (plus political ads elsewhere)
META_API_VERSION=v21.0
